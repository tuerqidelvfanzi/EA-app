{
  "name": "ecommerce-assistant-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3004 --host=0.0.0.0",
    "zip:extension": "node ../scripts/zip-extension.mjs",
    "prebuild": "npm run zip:extension",
    "build": "vite build && node ../scripts/copy-spa-fallback.mjs",
    "preview": "vite preview --port=3004",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:demo": "vite build --mode demo && node ../scripts/copy-spa-fallback.mjs",
    "preview:demo": "vite preview --port=3004 --mode demo"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@tanstack/react-query": "^5.74.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.2"
  }
}

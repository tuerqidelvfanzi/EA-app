{
  "name": "ecommerce-assistant-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node ./scripts/copy-schema.mjs",
    "start": "node dist/index.js",

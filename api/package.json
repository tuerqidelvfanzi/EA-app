    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.9.1",
    "crawlee": "^3.13.5",
    "hono": "^4.7.10",
    "jose": "^6.0.11",
    "playwright": "^1.52.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.1",
    "tsx": "^4.19.3",
    "typescript": "~6.0.3",
    "vitest": "^3.1.2"
  }
